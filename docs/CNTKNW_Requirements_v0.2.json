      "id": "INV-001",
      "text": "Exactly three primary destinations: Library, Gallery, Notes."
    },
    {
      "id": "INV-002",
      "text": "Books and artworks use one shared Study Workspace."
    },
    {
      "id": "INV-003",
      "text": "Each source has one continuous journal."
    },
    {
      "id": "INV-004",
      "text": "New blocks inherit active source location automatically."
    },
    {
      "id": "INV-005",
      "text": "Empty pages do not create visible journal sections."
    },
    {
      "id": "INV-006",
      "text": "Journal, outline, cards, and maps use the same canonical blocks."
    },
    {
      "id": "INV-007",
      "text": "Explicit connections provide backlinks."
    },
    {
      "id": "INV-008",
      "text": "Drawings and annotations retain editable data."
    },
    {
      "id": "INV-009",
      "text": "Core study capability works offline."
    },
    {
      "id": "INV-010",
      "text": "Manual focus timing is the default."
    },
    {
      "id": "INV-011",
      "text": "3D is optional and never gates content."
    },
    {
      "id": "INV-012",
      "text": "Chess is future Library content, not a main tab."
    },
    {
      "id": "INV-013",
      "text": "All schema changes include migrations."
